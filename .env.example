# --- n8n ---
GENERIC_TIMEZONE=America/Bogota
N8N_ENCRYPTION_KEY=change-this-to-a-random-32-char-string

# --- Connected WhatsApp AI Agent (github.com/andresnv22/whatsapp-ai-agent) ---
WHATSAPP_AGENT_URL=http://host.docker.internal:8000
ADMIN_TOKEN=change-this-admin-token

# --- Meta WhatsApp Cloud API ---
WHATSAPP_TOKEN=paste-your-meta-token-here
WHATSAPP_PHONE_NUMBER_ID=paste-your-phone-number-id
WHATSAPP_VERIFY_TOKEN=choose-a-random-verify-token
WHATSAPP_TEMPLATE_NAME=appointment_reminder

# --- Google Sheets & Telegram escalation ---
GOOGLE_SHEET_ID=paste-your-google-sheet-id
TELEGRAM_ESCALATION_CHAT_ID=paste-your-telegram-chat-id
